{
  "expo": {
    "name": "Lagerklar",
    "slug": "lagerklar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.anonymous.lagerklar.v1"
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#208A5A",
        "foregroundImage": "./assets/app-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.lagerklar.v1"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Appen skal bruge adgang til dine billeder, så du kan vælge et profilbillede eller et billede af en vare.",
          "cameraPermission": "Appen skal bruge adgang til kameraet, så du kan tage et profilbillede eller et billede af en vare.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4220cbed-451c-4c84-a09f-57d6f3c17618"
      }
    },
    "owner": "minhlu14206"
  }
}
