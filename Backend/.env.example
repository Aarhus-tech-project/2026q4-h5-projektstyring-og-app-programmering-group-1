PORT=8080

# Copy to .env and change the password. Do not commit .env to GitHub.
POSTGRES_DB=lagerklar
POSTGRES_USER=lagerklar
POSTGRES_PASSWORD=change-me

# Connection string for the Go/Gin backend
DATABASE_URL=postgres://lagerklar:change-me@localhost:5432/lagerklar?sslmode=disable

JWT_SECRET=replace-with-a-random-secret

# Gmail SMTP for sending emails (smtp.gmail.com:587, STARTTLS).
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your normal Gmail password.
GMAIL_EMAIL=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
