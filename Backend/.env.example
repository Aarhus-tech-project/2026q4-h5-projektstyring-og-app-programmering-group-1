PORT=8080

# Copy to .env and change the password. Do not commit .env to GitHub.
POSTGRES_DB=lagerklar
POSTGRES_USER=lagerklar
POSTGRES_PASSWORD=change-me

# Connection string for the Go/Gin backend
DATABASE_URL=postgres://lagerklar:change-me@localhost:5432/lagerklar?sslmode=disable

JWT_SECRET=replace-with-a-random-secret

# Gmail SMTP for sending emails (smtp.gmail.com:587, STARTTLS).
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your normal Gmail password.
GMAIL_EMAIL=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Caddy reverse proxy (HTTPS)
# Replace YOUR_PUBLIC_SERVER_IP with the server's public IP (e.g. 203.0.113.10) in BOTH lines.
# Uses `tls internal` (Caddy's own CA): clients show a certificate warning unless they trust it.
# For local development use SITE_ADDRESS=https://localhost and TLS_DEFAULT_SNI=localhost.
# With a domain later: set both to the domain and remove `tls internal` from caddy/Caddyfile.
SITE_ADDRESS=https://YOUR_PUBLIC_SERVER_IP
TLS_DEFAULT_SNI=YOUR_PUBLIC_SERVER_IP
# Host ports for Caddy. Change CADDY_HTTP_PORT if port 80 is already used (e.g. by nginx).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
