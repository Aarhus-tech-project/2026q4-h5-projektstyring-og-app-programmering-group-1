# Caddy reverse proxy for the LagerKlar Go/Gin backend.
#
# SITE_ADDRESS defaults to ":80" (plain HTTP on port 80).
# Set SITE_ADDRESS in .env to a real domain (e.g. api.example.com) and Caddy
# will automatically obtain and renew a Let's Encrypt HTTPS certificate.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# docker-compose.yml sets BACKEND_UPSTREAM=backend:8080 (the backend
	# container). The fallback host.docker.internal:8080 is for running the
	# backend on the host with `go run .`.
	reverse_proxy {$BACKEND_UPSTREAM:host.docker.internal:8080}

	log {
		output stdout
		format console
	}
}
